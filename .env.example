# Copy to .env at the repo root. One file serves every package.
# Database setup: guidelines/stack.md
DATABASE_URL="postgresql://planner:planner@localhost:5432/cabinet_planner"
SESSION_COOKIE_NAME="cp_session"
UPLOAD_DIR="./uploads"
API_PORT=3000

# Initial ADMIN account created by `pnpm --filter api prisma db seed`.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="change-me"
